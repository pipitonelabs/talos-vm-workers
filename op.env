# 1Password secret references, resolved at run time by `op run --env-file=op.env`.
# This file holds no secrets: each value is a pointer to a field in a 1Password item.
#
# Point these at your own vault/item/field, or skip 1Password and export the variables yourself
# (see "Credentials" in the README).

# https://<proxmox-host>:8006/
PROXMOX_VE_ENDPOINT=op://Kubernetes/proxmox/PROXMOX_VE_ENDPOINT
# user@realm!tokenid=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_VE_API_TOKEN=op://Kubernetes/proxmox/PROXMOX_VE_API_TOKEN
